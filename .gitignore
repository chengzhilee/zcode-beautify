# dependencies
node_modules/

# build output: intermediate tsc output is excluded, but the final
# esbuild bundles in dist/ ARE committed so users never need to build
!dist/
dist/*
!dist/cli.js
!dist/mcp/
!dist/mcp/server.js
*.tsbuildinfo

# logs
*.log
npm-debug.log*

# env & secrets
.env
.env.*

# editor / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# test artifacts
coverage/
screenshots/
packages/

# local scratch: CDP probe profiles, captured bundles, working notes
experiments/
assets/
.zcode/

# machine-local data and helpers (runtime data lives in the plugin data dir;
# these remain only as leftovers from before the data-dir migration)
dist.backup-*/
wallpapers/
library-cache/
zb-restart.ps1
